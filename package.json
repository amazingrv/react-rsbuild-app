{
  "name": "react-rsbuild-app",
  "version": "1.0.0",
  "description": "react app template with rsbuild, eslint and prettier",
  "author": "amazingrv",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env NODE_CONFIG_ENV=e0 rsbuild dev",
    "build": "cross-env NODE_CONFIG_ENV=e0 rsbuild build",
    "analyze": "cross-env NODE_CONFIG_ENV=e0 RSDOCTOR=true rsbuild build",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rsbuild/core": "^2.0.6",
    "@rsbuild/plugin-eslint": "^1.3.0",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rsdoctor/rspack-plugin": "^1.5.11",
    "@rstest/core": "^0.10.1",
    "@rstest/coverage-istanbul": "^0.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "autoprefixer": "^10.5.0",
    "config": "^4.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "liquidjs": "^10.27.0",
    "prettier": "^3.8.3"
  }
}
