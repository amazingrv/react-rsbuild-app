{
  "name": "react-rsbuild-app",
  "version": "1.0.0",
  "description": "react app template with rsbuild, eslint and prettier",
  "author": "amazingrv",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env NODE_CONFIG_ENV=e0 rsbuild dev",
    "build": "cross-env NODE_CONFIG_ENV=e0 rsbuild build",
    "analyze": "cross-env NODE_CONFIG_ENV=e0 RSDOCTOR=true rsbuild build",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rsbuild/core": "^2.1.9",
    "@rsbuild/plugin-eslint": "^2.0.2",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsdoctor/rspack-plugin": "^1.6.1",
    "@rstest/core": "^0.11.6",
    "@rstest/coverage-istanbul": "^0.11.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "config": "^4.4.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "liquidjs": "^10.28.0",
    "prettier": "^3.9.6"
  }
}
